{
    "rewrites": [
        {
            "source": "/c/:token",
            "destination": "/api/shared-case?token=:token"
        },
        {
            "source": "/shared/case/:token",
            "destination": "/api/shared-case?token=:token"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
